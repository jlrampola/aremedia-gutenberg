{
	"name": "aremedia-gutenberg",
	"version": "1.0.0",
	"private": true,
	"description": "A dynamic magazine-style category articles Gutenberg block.",
	"license": "GPL-2.0-or-later",
	"engines": { "node": "^22.22.2 || ^24.15.0" },
	"scripts": {
		"build": "node tools/build.mjs",
		"package": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/package.ps1",
		"start": "node tools/build.mjs --watch",
		"test": "node --test tests/*.test.mjs",
		"test:php": "php tests/render.php",
		"lint:js": "wp-scripts lint-js src/index.js tools/*.mjs tests/*.mjs",
		"lint:css": "wp-scripts lint-style src/style.css"
	},
	"devDependencies": { "@wordpress/scripts": "37.0.0" }
}
