# Retain plugin code, builds, development tooling and essential documentation.
/*
!/.gitignore
!/.gitattributes
!/.editorconfig
!/aremedia-gutenberg.php
!/src/
!/build/
!/tests/
/tests/*
!/tests/build.test.mjs
!/tests/editor.test.mjs
!/tests/sponsor.test.mjs
!/tests/render.php
!/tests/preview.php
!/tools/
/tools/*
!/tools/build.mjs
!/tools/check-layout.ps1
!/docs/
/docs/*
!/docs/images/
/docs/images/*
!/docs/images/wordpress-desktop.png
!/docs/images/wordpress-mobile.png
!/README.md
!/LICENSE
!/package.json
!/package-lock.json
!/composer.json
!/composer.lock
!/phpcs.xml.dist

# Ignore dependencies and local files inside retained directories too.
node_modules/
vendor/
.tools/
.superpowers/
.env
.env.*
*.log
.DS_Store
Thumbs.db
